Package: causalDT
Title: Causal Distillation Trees
Version: 0.0.1
Authors@R: c(
    person("Tiffany", "Tang", , "ttang4@nd.edu", role = c("aut", "cre"), comment = c(ORCID = "0000-0002-8079-6867")),
